{
  "name": "neerkaavalan",
  "version": "1.0.0",
  "private": true,
  "description": "NeerKaavalan - AI-powered autonomous water-body monitoring and floating-waste management platform",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' --filter './services/*' dev",
    "dev:api": "pnpm --filter @neerkaavalan/api dev",
    "dev:dashboard": "pnpm --filter dashboard dev",
    "dev:simulator": "pnpm --filter @neerkaavalan/simulator dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}